# ============ 合同风险审查系统 · 配置模板 ============
# 用法：Copy-Item .env.example .env  然后把 key 和本地模型路径填上
# 说明：.env 已被 gitignore，绝不会进版本库；本文件（.env.example）只放占位符，可以进版本库

# ================= LLM 供应商（切换只改这一段）=================
# 已内置三个 provider（映射见 config.py 的 PROVIDERS 表）：
#   dashscope : key 变量名 DASHSCOPE_API_KEY，base_url https://dashscope.aliyuncs.com/compatible-mode/v1
#   zhipu     : key 变量名 GLM_API_KEY，      base_url https://open.bigmodel.cn/api/paas/v4/
#   ollama    : key 变量名 LLM_API_KEY，      base_url http://localhost:11434/v1（本地部署，不校验 key）
LLM_PROVIDER=dashscope
LLM_MODEL=qwen3.8-flash

# 留空则用 provider 的默认端点
# LLM_BASE_URL=

# 采样温度。⚠️ 智谱的 OpenAI 兼容接口不支持 0（取值区间 (0,1)），用 0.01
LLM_TEMPERATURE=0

# 供应商特有的可选参数（JSON 字符串）。关掉思考模式能让单次调用从 35 秒降到 2 秒级
# LLM_EXTRA_BODY={"enable_thinking": false}

# 免费/低价模型常有 429 限流 → 交给 SDK 重试与指数退避
LLM_MAX_RETRIES=6
LLM_TIMEOUT=120

# 只填你在用的那个（本文件不进版本库）
DASHSCOPE_API_KEY=
GLM_API_KEY=

# ================= 检索与切块 =================
# 注意：下面这些键名必须与代码读取的一致（历史踩坑：.env 写 CHUNK_MAX_CHARS、代码读 CHUNK_SIZE，
#       结果指标里静默记成 chunk=? —— 不报错，只是悄悄丢信息）
TOP_K=5
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP=200
CHROMA_DIR=data/chroma_bge_m3

# ================= 本地向量模型（bge 系列）=================
# 国内下载 HuggingFace 模型用镜像
HF_ENDPOINT=https://hf-mirror.com
EMBED_MODEL_PATH=<你的模型目录>\bge-m3
EMBED_DEVICE=auto

# ================= 重排（Step 5.3 增强①）=================
# 粗召 RERANK_CANDIDATES 个 → cross-encoder 精排 → 取 TOP_K 段喂给 LLM（prompt 不膨胀）
RERANK_ENABLED=1
RERANK_MODEL_PATH=<你的模型目录>\bge-reranker-v2-m3
RERANK_CANDIDATES=20
RERANK_TOP_N=5
RERANK_DEVICE=auto
RERANK_MAX_LENGTH=512
